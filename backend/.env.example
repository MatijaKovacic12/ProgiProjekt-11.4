# --- Baza (PostgreSQL) ---
DB_URL=jdbc:postgresql://localhost:5433/turisticka_agencija
DB_TEST_URL=jdbc:postgresql://localhost:5433/turisticka_agencija_test
DB_USERNAME=agencija_app
DB_PASSWORD=promijeni-me

# --- OAuth 2.0 prijava  ---
# Redirect URI: http://localhost:8080/login/oauth2/code/google (odnosno .../microsoft)
GOOGLE_CLIENT_ID=promijeni-me
GOOGLE_CLIENT_SECRET=promijeni-me
MICROSOFT_CLIENT_ID=promijeni-me
MICROSOFT_CLIENT_SECRET=promijeni-me

# --- E-mail (SMTP; host i port su u application.properties) ---
MAIL_USERNAME=promijeni-me
MAIL_PASSWORD=promijeni-me

# --- Adresa web-klijenta (kamo se korisnik vraća nakon prijave) ---
FRONTEND_URL=http://localhost:5173
